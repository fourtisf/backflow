{
  "name": "@backflow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@backflow/core": "workspace:*"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "@types/node": "^22.20.5"
  }
}
