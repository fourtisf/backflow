# Copy to ./.env (repo root) and fill in. Never commit .env or keypairs.
#   cp config/.env.example .env

# ---- network ----
SOLANA_CLUSTER=devnet               # devnet | mainnet-beta (mainnet only with owner approval)
RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE
RPC_WS_URL=wss://devnet.helius-rpc.com/?api-key=REPLACE
HELIUS_API_KEY=REPLACE
HELIUS_WEBHOOK_SECRET=REPLACE

# ---- raydium launchlab ----
# Program IDs per cluster live in packages/core/src/chain.ts (verified against the SDK, docs/DECISIONS.md D-002).
#   devnet:  LaunchLab DRay6fNdQ5J82H7xV6uq2aV3mNrUZ1J4PgSKsWgptcm6  CPMM DRaycpLY18LhpbydsBWbVJtxpNv9oXPgjRSfpF2bWpYb  Lock DRay25Usp3YJAi7beckgpGUC7mGJ2cR1AVPxhYfwVCUX
#   mainnet: LaunchLab LanMV9sAd7wArD4vJFi2qDdfnVhFxYSUg6eADduJ3uj  CPMM CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C  Lock LockrWmn6K5twhz3y9w1dQERbmgSaRkfnTeTKbpofwE
# Optional override; defaults to the wSOL / constant-product / index 0 GlobalConfig for the cluster.
GLOBAL_CONFIG_PUBKEY=
# Printed by `pnpm platform:create --send`.
PLATFORM_CONFIG_PUBKEY=REPLACE_AFTER_CREATE
# CPMM AmmConfig (fee tier) for graduated pools. Leave empty to let platform:create pick the tier closest to 1%.
CP_CONFIG_ID=

# ---- keys (paths to keypair JSON files outside the repo) ----
# Generate with: pnpm --filter @backflow/scripts keys:new -- --dir /etc/backflow/keys
PLATFORM_ADMIN_KEYPAIR_PATH=/etc/backflow/keys/platform-admin.json   # move to Squads multisig before mainnet
PLATFORM_FEE_WALLET_KEYPAIR_PATH=/etc/backflow/keys/platform-fee.json
BUYBACK_WALLET_KEYPAIR_PATH=/etc/backflow/keys/buyback.json
DISTRIBUTOR_WALLET_KEYPAIR_PATH=/etc/backflow/keys/distributor.json
TREASURY_PUBKEY=REPLACE
# Optional platform wallets (pubkeys). Defaults: lock NFT wallet = platform fee wallet; vesting = none; transfer-fee auth = admin.
PLATFORM_LOCK_NFT_WALLET=
PLATFORM_VESTING_WALLET=
TRANSFER_FEE_EXTENSION_AUTH=

# ---- data ----
DATABASE_URL=postgresql://backflow:REPLACE@localhost:5432/backflow
REDIS_URL=redis://localhost:6379

# ---- storage ----
PINATA_JWT=REPLACE
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ---- pricing ----
SOL_USD_SOURCE=pyth                 # pyth | jupiter

# ---- api ----
DATA_MODE=mock                      # mock (Milestone 1) | live (from Milestone 3)
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# ---- web (exposed to the browser) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/live
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# ---- app ----
PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_WALLETS=REPLACE_COMMA_SEPARATED
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ---- workers (health ports, localhost only) ----
WORKER_INDEXER_PORT=4101
WORKER_BUYBACK_PORT=4102
WORKER_PAYOUT_PORT=4103
WORKER_HARVEST_PORT=4104
WORKER_RECONCILE_PORT=4105
