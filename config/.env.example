# Copy to ./.env (repo root) and fill in. Never commit .env or keypairs.
#   cp config/.env.example .env

# ---- network ----
SOLANA_CLUSTER=devnet               # devnet | mainnet-beta (mainnet only with owner approval)
RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE
RPC_WS_URL=wss://devnet.helius-rpc.com/?api-key=REPLACE
HELIUS_API_KEY=REPLACE
HELIUS_WEBHOOK_SECRET=REPLACE

# ---- raydium launchlab ----
# Program IDs per cluster live in packages/core/src/chain.ts (verified against the SDK, docs/DECISIONS.md D-002).
#   devnet:  LaunchLab DRay6fNdQ5J82H7xV6uq2aV3mNrUZ1J4PgSKsWgptcm6  CPMM DRaycpLY18LhpbydsBWbVJtxpNv9oXPgjRSfpF2bWpYb  Lock DRay25Usp3YJAi7beckgpGUC7mGJ2cR1AVPxhYfwVCUX
#   mainnet: LaunchLab LanMV9sAd7wArD4vJFi2qDdfnVhFxYSUg6eADduJ3uj  CPMM CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C  Lock LockrWmn6K5twhz3y9w1dQERbmgSaRkfnTeTKbpofwE
# Optional override; defaults to the wSOL / constant-product / index 0 GlobalConfig for the cluster.
GLOBAL_CONFIG_PUBKEY=
# Printed by `pnpm platform:create --send`.
PLATFORM_CONFIG_PUBKEY=REPLACE_AFTER_CREATE
# CPMM AmmConfig (fee tier) for graduated pools. Leave empty to let platform:create pick the tier closest to 1%.
CP_CONFIG_ID=

# ---- keys (paths to keypair JSON files outside the repo) ----
# Generate with: pnpm --filter @backflow/scripts keys:new -- --dir /etc/backflow/keys
PLATFORM_ADMIN_KEYPAIR_PATH=/etc/backflow/keys/platform-admin.json   # move to Squads multisig before mainnet
PLATFORM_FEE_WALLET_KEYPAIR_PATH=/etc/backflow/keys/platform-fee.json
BUYBACK_WALLET_KEYPAIR_PATH=/etc/backflow/keys/buyback.json
DISTRIBUTOR_WALLET_KEYPAIR_PATH=/etc/backflow/keys/distributor.json
TREASURY_PUBKEY=REPLACE
# Public keys of the hot wallets. The API (and workers that don't sign with a key) read these instead of
# loading keypair files; in production the API never reads a keypair file. Print them with
#   solana-keygen pubkey /etc/backflow/keys/buyback.json
BUYBACK_PUBKEY=
DISTRIBUTOR_PUBKEY=
PLATFORM_FEE_PUBKEY=
# Optional platform wallets (pubkeys). Defaults: lock NFT wallet = platform fee wallet; vesting = none; transfer-fee auth = admin.
PLATFORM_LOCK_NFT_WALLET=
PLATFORM_VESTING_WALLET=
TRANSFER_FEE_EXTENSION_AUTH=

# ---- data ----
DATABASE_URL=postgresql://backflow:REPLACE@localhost:5432/backflow
REDIS_URL=redis://localhost:6379

# ---- storage ----
PINATA_JWT=REPLACE
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
# The only IPFS gateway the web loads coin images from (CSP img-src). Use the same gateway as PINATA_GATEWAY.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ---- pricing ----
SOL_USD_SOURCE=pyth                 # pyth | jupiter

# ---- api ----
DATA_MODE=mock                      # mock (Milestone 1) | live (from Milestone 3)
API_PORT=4000
API_HOST=127.0.0.1                  # loopback only; Nginx is the way in. Never 0.0.0.0 on the VPS.
# Proxies whose X-Forwarded-For the API trusts (IPs/CIDRs, comma-separated, or a hop count). Nginx on the
# same host: 127.0.0.1. "true" is refused, because it would let clients pick their own rate-limit bucket.
TRUST_PROXY=127.0.0.1
CORS_ORIGINS=http://localhost:3000
# Host shown in signed sign-in messages (admin, launch, Telegram). Defaults to the host of PUBLIC_SITE_URL.
# Must be the site users actually see, e.g. backflow.example, so signatures can't be replayed elsewhere.
AUTH_DOMAIN=
# WebSocket /live caps: total open connections, and per client address (IPv6 per /64).
WS_MAX_CONNECTIONS=2000
WS_MAX_PER_IP=20

# ---- web (exposed to the browser) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/live
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# ---- app ----
PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_WALLETS=REPLACE_COMMA_SEPARATED
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Server-side origin of the API for Next.js server rendering (coin page metadata, share images).
API_INTERNAL_URL=http://127.0.0.1:4000
# Optional privacy-friendly analytics (Plausible). Leave empty to load no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---- holder payout alerts on Telegram (optional, D-027) ----
# Bot that messages holders who linked their wallet; the webhook must send TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- vanity "…back" mint addresses (optional, D-025) ----
VANITY_ENABLED=0
# 32-byte hex key that encrypts stored vanity keypairs (openssl rand -hex 32). API and vanity:grind only.
VANITY_KEY=

# ---- transactions ----
PRIORITY_FEE_MICROLAMPORTS=20000
# Address lookup table from `pnpm alt:create -- --send` (optional, recommended).
BACKFLOW_ALT=
# Mainnet only, set by the owner after approval (CLAUDE.md rule 2): BACKFLOW_MAINNET_APPROVED=owner-approved-mainnet

# ---- optional Jupiter routing for post-graduation buybacks (D-028) ----
JUPITER_BUYBACKS=0
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# ---- worker timing ----
INDEXER_INTERVAL_MS=3000
BUYBACK_INTERVAL_MS=5000
CLAIM_INTERVAL_SEC=3600
HARVEST_INTERVAL_SEC=3600
ALERT_FAILED_PAYOUTS=10
LOG_LEVEL=info

# ---- pnpm sim (devnet only) ----
SIM_WALLET_DIR=~/.config/backflow/sim
SIM_FUNDER_KEYPAIR_PATH=
SIM_METADATA_URI=

# ---- workers (health ports, localhost only) ----
WORKER_INDEXER_PORT=4101
WORKER_BUYBACK_PORT=4102
WORKER_PAYOUT_PORT=4103
WORKER_HARVEST_PORT=4104
WORKER_RECONCILE_PORT=4105
